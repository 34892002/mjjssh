{"schemaVersion":1,"id":"reinstall-debian-12","name":"重装 Debian 12","description":"下载 InstallNET 脚本并重装为 Debian 12；将覆盖当前系统。","tags":["dd","reinstall","debian"],"command":"apt update && wget --no-check-certificate -qO InstallNET.sh 'https://raw.githubusercontent.com/leitbogioro/Tools/master/Linux_reinstall/InstallNET.sh' && chmod a+x InstallNET.sh && bash InstallNET.sh -debian 12 -pwd '123456789abcdef'","riskLevel":"high","platforms":["linux"],"version":"1.0.0","homepage":"https://github.com/leitbogioro/Tools"}
{"schemaVersion":1,"id":"reinstall-debian-cn","name":"重装 Debian（国内源）","description":"下载 debi 脚本并以国内源重装 Debian；将覆盖当前系统。","tags":["dd","reinstall","debian","china"],"command":"bash <(curl -fsSL https://raw.githubusercontent.com/bohanyang/debi/master/debi.sh) --user root --password '123456789abcdef' --ustc --timezone Asia/Shanghai --dns '119.29.29.29' --bbr","riskLevel":"high","platforms":["linux"],"version":"1.0.0","homepage":"https://github.com/bohanyang/debi"}
